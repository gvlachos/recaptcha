####################################################################
# reCAPTCHA (Sept 2026) verification service — environment config
#
# Copy this file to `.env` (per environment: .env.dev / .env.uat /
# .env.prod, or whatever mechanism your deployment pipeline already
# uses) and fill in the real values. NEVER commit a filled-in .env
# file to source control.
#
# This file documents every variable the service reads. Variables
# marked (REQUIRED) will cause the service to fail fast on startup
# if missing — see src/config.js for the validation logic.
####################################################################


# --------------------------------------------------------------
# 1. GOOGLE CLOUD PROJECT
# --------------------------------------------------------------

# (REQUIRED) The Google Cloud *project number* (NOT the project ID
# string) that owns your reCAPTCHA keys for this environment.
#
# Per the recommended topology (one project per environment tier:
# recaptcha-dev / recaptcha-uat / recaptcha-prod), this value
# changes per environment — set it in the environment-specific
# .env file / secret, not hardcoded in code.
#
# Find it with:
#   gcloud projects describe YOUR_PROJECT_ID --format="value(projectNumber)"
RECAPTCHA_PROJECT_NUMBER=123456789012


# --------------------------------------------------------------
# 2. AUTHENTICATION TO GOOGLE CLOUD (on-prem backend)
# --------------------------------------------------------------
#
# Because this backend runs on-premises (not on GKE/Cloud Run/GCE),
# there is no ambient "Application Default Credentials" metadata
# server to fall back on. You MUST provide one of the two supported
# credential sources below. See README.md section "Authentication"
# for full setup instructions for each option.
#
# Option A — Workload Identity Federation (RECOMMENDED / target state)
#   No long-lived Google key material is stored on-prem. Your
#   on-prem OIDC/SAML identity provider issues a short-lived token
#   that Google exchanges for temporary credentials.
#
#   Set GOOGLE_APPLICATION_CREDENTIALS to the path of the *WIF
#   credential configuration JSON* (NOT a service account key) that
#   you generated with:
#     gcloud iam workload-identity-pools create-cred-config ...
#   (see README.md for the full gcloud command).
#
# Option B — Service account JSON key file (INTERIM / higher risk)
#   Set GOOGLE_APPLICATION_CREDENTIALS to the path of a downloaded
#   service-account key file. This is a long-lived static secret:
#   store it in your on-prem secrets manager (Vault, etc.), inject
#   it at process start (e.g. mounted into the container / VM at
#   runtime), rotate it on a documented schedule, and NEVER commit
#   it to source control or bake it into a container image.
#
# Either way, this env var just needs to point at a file path — the
# Google client library auto-detects whether it's a WIF config or a
# service account key and behaves accordingly.
#
# (REQUIRED unless GOOGLE_APPLICATION_CREDENTIALS is already set at
# the OS/container level outside of this .env file.)
GOOGLE_APPLICATION_CREDENTIALS=/secure/config/recaptcha-credential-config.json


# --------------------------------------------------------------
# 3. SITE KEYS (frontend keys, one per application)
# --------------------------------------------------------------
#
# The Node.js backend does not need to know every one of the 15
# frontend site keys individually in most designs (the frontend
# sends the token; the backend just needs the *expected* site key
# to validate against, per app/route, to guard against a token
# minted for one app being replayed against another app's backend
# endpoint).
#
# Recommended pattern: define one env var per application this
# backend instance serves, e.g.:
#
#   RECAPTCHA_SITE_KEY_APP01=6Lc-your-real-site-key-app01
#   RECAPTCHA_SITE_KEY_APP02=6Lc-your-real-site-key-app02
#
# If this backend instance only ever serves a single application,
# a single var is enough:
RECAPTCHA_SITE_KEY=6Lc-your-real-site-key-here


# --------------------------------------------------------------
# 4. SCORE THRESHOLD AND POLICY
# --------------------------------------------------------------

# (OPTIONAL, default: 0.5) The minimum risk score (0.0-1.0,
# 1.0 = very likely human) required for a request to be treated as
# "verified". This mirrors the > 0.5 cutoff your applications use
# today with classic reCAPTCHA v3. Re-validate this value against
# real post-migration traffic rather than assuming it is still
# optimal — see the migration guide, Section 4.3 step 6.
RECAPTCHA_SCORE_THRESHOLD=0.5

# (OPTIONAL, default: 3600 = 1 hour) How many seconds a token is
# considered valid for by your own application-level logic on top
# of Google's own token-expiry handling. Google score-based tokens
# are valid for 2 minutes by design; this setting exists only if
# you want an application-level safety margin — leave at default
# unless you have a specific reason to change it.
RECAPTCHA_TOKEN_MAX_AGE_SECONDS=120


# --------------------------------------------------------------
# 5. SERVICE / HTTP CONFIGURATION
# --------------------------------------------------------------

# (OPTIONAL, default: 3000) Port the example Express server listens
# on. Irrelevant if you import the verification module into an
# existing service instead of running server.js standalone.
PORT=3000

# (OPTIONAL, default: development) Free-text environment label used
# only for structured log output (e.g. "dev", "uat", "prod"). Purely
# cosmetic/diagnostic — does not affect which Google Cloud project
# is called (that is controlled entirely by RECAPTCHA_PROJECT_NUMBER
# and the credentials above).
APP_ENV=development
